{
    "name": "weidner/goutte",
    "version": "2.3.2",
    "description": "Laravel Facade for Goutte, a simple PHP Web Scraper",
    "license": "MIT",
    "keywords": [
        "weidner",
        "goutte",
        "laravel"
    ],
    "homepage": "https://github.com/dweidner/laravel-goutte",
    "authors": [
        {
            "name": "Daniel Weidner",
            "email": "hallo@danielweidner.de",
            "homepage": "https://danielweidner.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "symfony/browser-kit": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/css-selector": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Weidner\\Goutte\\": "src/",
            "Goutte\\": "src/Compat/Goutte/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weidner\\Goutte\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        },
        "laravel": {
            "providers": [
                "Weidner\\Goutte\\GoutteServiceProvider"
            ],
            "aliases": {
                "Goutte": "Weidner\\Goutte\\GoutteFacade"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
